# AARVIK Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Example Local: mongodb://127.0.0.1:27017/aarvik
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aarvik?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aarvik

# JWT Secret Key for Administrator Authentication (Use a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret

# Token Expiry (e.g., 24h, 7d)
JWT_EXPIRES_IN=24h

# CORS Frontend Origin
CLIENT_URL=http://localhost:5173

# Future AABHAS AI/ML Model API Endpoint (Optional / Disabled by default)
AABHAS_API_URL=http://localhost:8000/api/v1/predict
AABHAS_API_KEY=your_aabhas_api_key_placeholder
